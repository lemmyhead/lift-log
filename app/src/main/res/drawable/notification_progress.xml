<?xml version="1.0" encoding="utf-8"?>
<!--
  Rest elapsed against target.

  Tinted here rather than from code because ProgressBar has no remotable tint setter — a
  RemoteViews cannot recolour it after inflation, so the colour has to live in the drawable.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/notification_progress_track" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="@color/notification_accent" />
                <corners android:radius="2dp" />
            </shape>
        </scale>
    </item>
</layer-list>
